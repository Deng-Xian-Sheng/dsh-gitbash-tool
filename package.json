{
  "name": "dsh-gitbash-tool",
  "version": "0.1.2",
  "description": "Model-facing Git Bash tool for DeepSeek Harness on Windows: auto-provisions Git for Windows when missing, runs under the default ACL sandbox through a native MSYS guard, and routes shell work to Git Bash while preserving the PowerShell syntax reference.",
  "type": "module",
  "private": false,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "native",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0",
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git-bash",
    "windows",
    "shell"
  ],
  "license": "MIT"
}
